        "rules": [
          {
            "name": "Here's Negan",
            "id": "3caf-4cf7-e8a2-0d43",
            "description": "If Negan removes one or more enemy Survivors from play in melee, all friendly Saviors treat their Nerve as High in the following Action Phase.",
            "hidden": false
          },
          {
            "name": "Leader Ability: Impress Me!",
            "id": "d7d6-8d14-adce-399c",
            "description": "Each time a Budding Lieutenant model Impresses Negan (see other Survivor Cards) that model receives one red die, forming a special pool of dice on its card to use with any roll.",
            "hidden": false
          },
          {
            "name": "You Scared?",
            "id": "5021-3a1c-53a8-0e4e",
            "description": "Each time a friendly Savior within 6\" of Negan rolls a Yellow die, that model loses 1 Health, and Negan adds a Red die to his Melee value for the rest of the turn.",
            "hidden": false
          }
        ],
