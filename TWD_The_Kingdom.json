        ],
        "rules": [
          {
            "name": "Commanding Presence",
            "id": "709d-dcd7-1926-bc7b",
            "description": "When making a Hold Your Nerve Action, Ezekial does not roll the Black die. Instead, he immediately reduces the Threat Level by 1 White.",
            "hidden": false
          },
          {
            "name": "Shiva",
            "id": "71c6-4b80-094a-a496",
            "description": "If Shiva is engaged in the same combat as Ezekiel, both Ezekiel and Shiva add 1 Red to their melee attack rolls.",
            "hidden": false
          },
          {
            "name": "Leader Ability: The King",
            "id": "3707-51fd-c106-1b4d",
            "description": "Once per game, Ezekiel and every Survivor in his group from the Kingdom Faction may perform one extra Action during their activation. This bonus lasts for only a single Action phase - if the extra Action is not used, it is wasted.",
            "hidden": false
          }
        ]
      },
