        "rules": [
          {
            "name": "Beast",
            "id": "2914-b818-cd68-3208",
            "description": "Shiva may Run 10\" and may never Defend in combat. In addition, all of her melee attacks have the Sharp keyword.",
            "hidden": false
          },
          {
            "name": "Tiger!",
            "id": "5eb0-fc8f-67b9-51c9",
            "description": "Enemy Survivors within Shiva's Kill Zone treat their Nerve as one level lower than usual.",
            "hidden": false
          },
          {
            "name": "Furious Assault",
            "id": "3a25-619f-2605-45ec",
            "description": "Once per turn, if Shiva wins a melee, she may immediately move into base contact with a new, standing enemy within 6\". Resolve this new combat immediately, even if one or more combatants has already fought.",
            "hidden": false
          }
        ]
