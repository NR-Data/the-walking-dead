        "rules": [
          {
            "name": "Leader Ability: Unchallenged",
            "id": "be38-7920-a2ef-26ab",
            "description": "For the purposes of the Whisperer and One of the Herd rules, Alpha treats all friendly Whisperer models as Walkers.",
            "hidden": false
          },
          {"name": "Animals Need a Leader", "id": "169f-0a37-1b62-03bc", "description": "If Alpha is included in the group, she must be the Leader.", "hidden": false},
          {
            "name": "The Alpha",
            "id": "d9fd-e37c-91a7-8018",
            "description": "When using the Whisperer rule, Alpha may move all Walkers in her Kill Zone as a single action, instead of just one.",
            "hidden": false
          }
        ]
      },
