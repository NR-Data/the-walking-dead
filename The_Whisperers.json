        ],
        "rules": [
          {
            "name": "Jolly Green Gi-",
            "id": "5f37-904f-d3ef-f3e4",
            "description": "Beta ignores the Bulky keyword. In addition, enemy Survivors in Beta's Kill Zone treat their Nerve as one level lower than usual.",
            "hidden": false
          },
          {
            "name": "Bodyguard",
            "id": "f696-18c2-3b85-20b3",
            "description": "If Alpha is in the same group and is targeted by a ranged attack while within Beta's Kill Zone, Beta may take the attack on Alpha's behalf. Beta becomes the new target, even if he was not initially within range or line of sight.",
            "hidden": false
          },
          {
            "name": "Survival of the Strongest",
            "id": "622d-4b96-5a21-73b9",
            "description": "In the Melee phase, when engaged with an enemy Survivor that has more remaining Health points than Beta, Beta adds 1White to Melee and Defense for the duration of that Melee phase.",
            "hidden": false
          }
        ]
      },
