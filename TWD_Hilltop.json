        ],
        "rules": [
          {
            "name": "Tactical Advantage",
            "id": "fb34-c6b3-9c02-e1d6",
            "description": "At the start of a Melee phase in which any friendly Hilltop models are in combat (not including Maggie herself), roll 1Black. On a Shield, the Threat Level does not increase.",
            "hidden": false
          },
          {
            "name": "Widow",
            "id": "d965-380b-2d52-64e4",
            "description": "As long as a friendly Glenn is not in play, Maggie may reroll blanks on any White she rolls.",
            "hidden": false
          },
          {
            "name": "Leader Ability: Organised Leaderhship",
            "id": "022d-4b16-85a6-277e",
            "description": "Maggie may sacrifice any number of actions to add 1Blue per action to a special dice pool. In the Melee phase, friendly Hilltop models may add these dice to their side's melee attack or defense rolls, at a rate of 1Blue per combat.",
            "hidden": false
          }
        ]
      },
