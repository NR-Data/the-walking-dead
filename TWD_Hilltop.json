        "rules": [
          {
            "name": "Martial Artist",
            "id": "6909-7b6f-f295-6d9c",
            "description": "When Jesus has no Melee Weapon equipped, he adds 1White to his melee attack rolls and gains the Stun keyword.",
            "hidden": false
          },
          {
            "name": "Moving Target",
            "id": "bc6d-a9c4-1185-ff5b",
            "description": "When Jesus Runs 5\" or more in his activation, he adds 1Blue to his Defense for the rest of the turn.",
            "hidden": false
          },
          {
            "name": "Disarm",
            "id": "2dd8-354d-193d-eb29",
            "description": "If Jesus defends in melee and his side wins, you may roll 1Black. On a Shield, Jesus steals one random equipped melee weapon from an opponent. He must choose to either equip it (if permitted) or discard it (he may not put it in a Pack slot).",
            "hidden": false
          }
        ]
