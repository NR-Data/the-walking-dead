        "rules": [
          {"name": "Rebellious Streak", "id": "a957-160e-af8e-df77", "description": "Mercer cannot be the Leader if Pamela Milton is in the same group.", "hidden": false},
          {
            "name": "Show Them How It's Done",
            "id": "39ad-3fb3-4d24-ff85",
            "description": "At the end of a turn in which Mercer removes at least 2 Walkers from play, reduce the Threat Level by 1.",
            "hidden": false
          },
          {
            "name": "Leader Ability: General",
            "id": "4367-1006-62d1-ba4e",
            "description": "When Mercer is the Leader, you may include any number of Commonwealth Troopers in your group, regardless of Type. Models with the Commonwealth Trooper name or subtitle within 6\" of Mercer treat their Nerve as High.",
            "hidden": false
          }
        ]
