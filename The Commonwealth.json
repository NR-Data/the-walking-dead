        "rules": [
          {
            "name": "Hierarchical",
            "id": "50f0-20a6-6c66-6fe2",
            "description": "When Pamela is targeted by a ranged attack you may choose one friendly Minion in her Kill Zone and roll 1Black. On a Shield, that model takes the attack instead of er, even if it was not in range or line of sight.",
            "hidden": false
          },
          {
            "name": "Leader Ability: New World Order",
            "id": "505e-b001-34b0-02f4",
            "description": "Once per game, as a special action, Pamela awards 1Red to every friendly Commonwealth model within 8\". This turn, each model may add this bonus die to a single attack or defense roll. Unused dice are lost at the end of the turn.",
            "hidden": false
          }
        ]
